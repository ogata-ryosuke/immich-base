# このファイルを .env にコピーして編集する:  copy example.env .env
# .env は .gitignore 済み（秘密情報。git に含めない）

# --- バージョン / イメージ ---------------------------------------------------
# 公式 release notes を確認し、動作確認済みのタグに固定する（release のまま運用しない）
# https://github.com/immich-app/immich/releases
IMMICH_VERSION=release
# DB / redis のイメージは公式 example.env と一致させること（勝手に上げない）
DB_IMAGE=ghcr.io/immich-app/postgres:14-vectorchord0.3.0-pgvectors0.2.0
REDIS_IMAGE=docker.io/valkey/valkey:8-bookworm

# --- ストレージのパス（Windows。スラッシュは / を使う） ----------------------
# 新規アップロード先（大容量になるので RAID 可。例: E:/immich/upload）
UPLOAD_LOCATION=E:/immich/upload
# 既存写真ライブラリ（外部ライブラリとして読み取り専用マウント。例: E:/Photos）
# ★ 実在するフォルダのパスを指定する。中身は空でよいが、この値自体を空にしない。
#    未設定/空にした場合は ./external-placeholder（ダミー空フォルダ）が使われ、起動は通る。
#    既存写真を使うときは、先に mkdir E:\Photos してから実パスを指定すること。
EXTERNAL_LIBRARY=E:/Photos
# ★ Postgres データ。必ず内蔵SSDの安定パスに（USB切断で壊れる場所に置かない）
DB_DATA_LOCATION=C:/immich/postgres

# --- データベース資格情報 ---------------------------------------------------
DB_USERNAME=immich
DB_DATABASE_NAME=immich
# ★ 強いパスワードに変更すること
DB_PASSWORD=CHANGE_ME_STRONG_PASSWORD

# --- immich 側の公開URL（Tailscale の HTTPS 名を後で入れる） ------------------
# docs/01-tailscale.md 参照。例: https://immich-pc.taro.ts.net
# IMMICH_SERVER_URL=

# --- バックアップ（scripts/backup-db.ps1 が参照） ----------------------------
# DBダンプの保存先（できれば RAID とは別の物理ディスク or クラウド同期フォルダ）
BACKUP_DIR=C:/immich/backups
# 保持世代数（これより古いダンプは自動削除）
BACKUP_KEEP=14
